# 관리자 비밀번호 (NF-01: 코드에 넣지 말고 환경변수로만)
ADMIN_PASSWORD=change-me
# JWT 서명 키 (긴 무작위 문자열)
JWT_SECRET=change-me-to-a-long-random-string
# Groq API 키 (https://console.groq.com, 무료 플랜)
GROQ_API_KEY=
# 선택: Groq 모델
GROQ_MODEL=llama-3.3-70b-versatile
# 비워두면 로컬 SQLite(local.db) 사용. 배포 시 Neon 연결 문자열
DATABASE_URL=
